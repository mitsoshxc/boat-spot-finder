@model MarinaLayoutViewModel
@{
    ViewData["Title"] = $"Layout · {Model.Name}";
}

@Html.AntiForgeryToken()

<section class="workspace workspace--editor">
    <header class="workspace__head workspace__head--editor">
        <div class="workspace__head-titles">
            <span class="workspace__mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                    <rect x="4" y="6" width="24" height="3" rx="0.5" />
                    <rect x="14.5" y="9" width="3" height="20" rx="0.5" />
                    <line x1="8" y1="6" x2="8" y2="3" />
                    <line x1="24" y1="6" x2="24" y2="3" />
                    <line x1="17.5" y1="14" x2="21" y2="14" opacity="0.55"/>
                    <line x1="17.5" y1="20" x2="21" y2="20" opacity="0.55"/>
                    <line x1="17.5" y1="26" x2="21" y2="26" opacity="0.55"/>
                </svg>
            </span>
            <span class="workspace__eyebrow">Layout editor</span>
            <h1 class="workspace__title">@Model.Name</h1>
            <p class="workspace__lede">Place spots on the layout. Drag corners to resize, click a spot to edit.</p>
        </div>
        <div class="toolbar">
            <a class="link--quiet" asp-action="Edit" asp-route-id="@Model.Id">&larr; Marina details</a>
            <button type="button" id="btn-add-spot" class="btn btn--ghost btn--sm">
                <span class="btn__sigil" aria-hidden="true">+</span> Add spot
            </button>
            <button type="button" id="btn-save-layout" class="btn btn--primary btn--sm">Save layout</button>
        </div>
    </header>

    <div class="editor-grid">
        <article class="canvas-shell">
            <header class="canvas-shell__caption">
                <span class="canvas-shell__caption-label">Plate</span>
                <span class="canvas-shell__caption-meta">@(Model.LayoutWidth) &times; @(Model.LayoutHeight) <span class="canvas-shell__caption-unit">u</span></span>
            </header>
            <div class="canvas-shell__frame">
                <span class="canvas-shell__corner canvas-shell__corner--tl" aria-hidden="true"></span>
                <span class="canvas-shell__corner canvas-shell__corner--tr" aria-hidden="true"></span>
                <span class="canvas-shell__corner canvas-shell__corner--bl" aria-hidden="true"></span>
                <span class="canvas-shell__corner canvas-shell__corner--br" aria-hidden="true"></span>
                <div class="canvas-shell__viewport">
                    <div id="canvas-container"
                         data-marina-id="@Model.Id"
                         data-spot-create-url="@Url.Action("Create", "Spots", new { marinaId = Model.Id })"
                         data-spot-edit-url-template="/placeowner/marinas/@Model.Id/spots/__ID__/edit"
                         style="width:@(Model.LayoutWidth)px; height:@(Model.LayoutHeight)px;">
                        @if (string.IsNullOrEmpty(Model.BackgroundImagePath))
                        {
                            <div class="canvas-placeholder">
                                <span class="vignette vignette--muted" aria-hidden="true">
                                    <svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="0.7">
                                        <rect x="6" y="6" width="52" height="36" rx="1" />
                                        <circle cx="22" cy="20" r="3" />
                                        <path d="M6 36 L24 22 L36 32 L58 14" />
                                    </svg>
                                </span>
                                <p class="canvas-placeholder__text">Upload a marina photo to begin.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <form asp-action="UploadBackground"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data"
                  class="upload-row"
                  id="background-upload-form">
                <input type="file"
                       name="backgroundImage"
                       accept="image/jpeg,image/png,image/webp"
                       class="upload-row__input"
                       required />
                <button type="submit" class="btn btn--ghost btn--sm">Upload background</button>
                <span class="upload-row__hint">JPG, PNG, or WebP &middot; up to 5&nbsp;MB.</span>
                <p class="upload-row__error" id="background-upload-error" role="alert" hidden></p>
            </form>
        </article>

        <aside class="spot-sidebar" id="spot-sidebar">
            <header class="spot-sidebar__head">
                <h2 class="spot-sidebar__title">Spots</h2>
                <span class="spot-sidebar__count">@Model.Spots.Count</span>
            </header>
            @if (!Model.Spots.Any())
            {
                <p class="spot-sidebar__empty">No spots yet. Use <em>Add spot</em> in the toolbar to define your first.</p>
            }
            else
            {
                <ul class="spot-sidebar__list">
                    @foreach (var s in Model.Spots)
                    {
                        var unplaced = s.CanvasX == null || s.CanvasY == null || s.CanvasW == null || s.CanvasH == null;
                        var pillClass = unplaced ? "pill--unplaced" : (s.IsActive ? "pill--active" : "pill--inactive");
                        var pillLabel = unplaced ? "Unplaced" : (s.IsActive ? "Active" : "Inactive");
                        <li class="spot-sidebar__item">
                            <div class="spot-sidebar__row">
                                <span class="spot-sidebar__name">@s.Name</span>
                                <span class="pill @pillClass"><span class="pill__dot" aria-hidden="true"></span>@pillLabel</span>
                            </div>
                            <a class="spot-sidebar__edit" href="@Url.Action("Edit", "Spots", new { marinaId = Model.Id, id = s.Id })">Edit details &rarr;</a>
                        </li>
                    }
                </ul>
            }
        </aside>
    </div>
</section>

<div id="add-spot-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="add-spot-modal-title" hidden>
    <div class="modal__backdrop" data-modal-dismiss aria-hidden="true"></div>
    <div class="modal__panel">
        <header class="modal__head">
            <span class="ornament" aria-hidden="true">
                <svg viewBox="0 0 64 12" fill="none" stroke="currentColor" stroke-width="0.7">
                    <line x1="0" y1="6" x2="22" y2="6"/>
                    <circle cx="32" cy="6" r="0.8" fill="currentColor" stroke="none"/>
                    <path d="M32 1 L33.5 6 L32 11 L30.5 6 Z" fill="currentColor" stroke="none" opacity="0.6"/>
                    <path d="M26 6 L32 5 L38 6 L32 7 Z" fill="currentColor" stroke="none" opacity="0.6"/>
                    <line x1="42" y1="6" x2="64" y2="6"/>
                </svg>
            </span>
            <h2 id="add-spot-modal-title" class="modal__title">Add a spot</h2>
            <p class="modal__lede">Define dimensions and price. You&rsquo;ll place it on the canvas afterwards.</p>
        </header>
        <form id="add-spot-form" class="form modal__form" novalidate>
            <div class="field">
                <label for="add-spot-name" class="field__label">Name</label>
                <input id="add-spot-name" name="Name" required class="field__input" autocomplete="off" />
            </div>
            <div class="field">
                <label for="add-spot-description" class="field__label">Description</label>
                <textarea id="add-spot-description" name="Description" rows="3" class="field__input field__input--area"></textarea>
            </div>
            <div class="field-row field-row--three">
                <div class="field">
                    <label for="add-spot-length" class="field__label">Length &middot; m</label>
                    <input id="add-spot-length" name="LengthMeters" type="number" step="0.1" min="0" required class="field__input field__input--mono" />
                </div>
                <div class="field">
                    <label for="add-spot-width" class="field__label">Width &middot; m</label>
                    <input id="add-spot-width" name="WidthMeters" type="number" step="0.1" min="0" required class="field__input field__input--mono" />
                </div>
                <div class="field">
                    <label for="add-spot-depth" class="field__label">Depth &middot; m</label>
                    <input id="add-spot-depth" name="DepthMeters" type="number" step="0.1" min="0" required class="field__input field__input--mono" />
                </div>
            </div>
            <div class="field">
                <label for="add-spot-price" class="field__label">Price per day</label>
                <div class="field-currency">
                    <span class="field-currency__symbol" aria-hidden="true">&euro;</span>
                    <input id="add-spot-price" name="PricePerDay" type="number" step="0.01" min="0" required class="field__input field__input--currency" />
                    <span class="field-currency__suffix" aria-hidden="true">/ day</span>
                </div>
            </div>
            <div class="field">
                <label for="add-spot-min-booking" class="field__label">Minimum booking &middot; days</label>
                <input id="add-spot-min-booking" name="DefaultMinBookingDays" type="number" step="1" min="1" max="365" value="1" required class="field__input field__input--mono" />
            </div>
            <div class="modal__errors" hidden></div>
            <div class="modal__actions">
                <button type="button" class="link--quiet" data-modal-dismiss>Cancel</button>
                <button type="submit" class="btn btn--primary btn--sm">Add spot</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/konva@9/konva.min.js"></script>
    <script src="~/js/marina-editor.js" asp-append-version="true"></script>
}
