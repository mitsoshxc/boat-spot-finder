@using Microsoft.AspNetCore.Identity
@inject SignInManager<BoatSpotFinder.Core.Entities.ApplicationUser> SignInManager
@inject UserManager<BoatSpotFinder.Core.Entities.ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="auth-strip auth-strip--signed-in">
        <span class="auth-strip__greeting">
            <span class="auth-strip__greeting-label">Signed in as</span>
            <span class="auth-strip__greeting-name">@UserManager.GetUserName(User)</span>
        </span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="auth-strip__form">
            <button type="submit" class="link link--quiet">Sign out</button>
        </form>
    </div>
}
else
{
    <div class="auth-strip">
        <a class="link link--quiet" asp-controller="Account" asp-action="Register">Register</a>
        <a class="btn btn--sm" asp-controller="Account" asp-action="Login">Sign in</a>
    </div>
}
