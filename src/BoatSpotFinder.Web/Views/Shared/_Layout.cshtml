<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Boat Spot Finder</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BoatSpotFinder.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                        <circle cx="16" cy="16" r="0.9" fill="currentColor" stroke="none"/>
                        <path d="M16 3 L16 29 M3 16 L29 16"/>
                        <path d="M16 6 L18 16 L16 26 L14 16 Z" fill="currentColor" stroke="none" opacity="0.55"/>
                        <path d="M6 16 L16 14 L26 16 L16 18 Z" fill="currentColor" stroke="none" opacity="0.55"/>
                    </svg>
                </span>
                <span class="brand__wordmark">
                    <span class="brand__name">Boat Spot Finder</span>
                    <span class="brand__tag">est. on the water</span>
                </span>
            </a>
            <nav class="site-nav" aria-label="Primary">
                <ul class="site-nav__list">
                    <li><a class="site-nav__link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a class="site-nav__link" href="/admin/dashboard">Admin panel</a></li>
                    }
                    @if (User.IsInRole("PlaceOwner"))
                    {
                        <li><a class="site-nav__link" href="/placeowner/marinas">My Marinas</a></li>
                        <li><a class="site-nav__link" href="/placeowner/spot-bookings">Incoming Bookings</a></li>
                    }
                    @if (User.IsInRole("BoatOwner"))
                    {
                        <li><a class="site-nav__link" href="/browse">Browse</a></li>
                        <li><a class="site-nav__link" href="/bookings">My Bookings</a></li>
                        <li><a class="site-nav__link" href="/vessels">My Vessels</a></li>
                    }
                </ul>
            </nav>
            <div class="site-header__auth">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <span class="site-footer__rule" aria-hidden="true"></span>
            <p class="site-footer__copy">&copy; 2026 Boat Spot Finder &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
