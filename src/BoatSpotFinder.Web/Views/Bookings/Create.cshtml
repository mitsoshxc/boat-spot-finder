@model BookingCreateViewModel
@{
    ViewData["Title"] = "Request a booking";
}

<section class="workspace workspace--narrow">
    <header class="workspace__head">
        <span class="workspace__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                <circle cx="11" cy="21" r="4.5"/>
                <circle cx="11" cy="21" r="1.4" fill="currentColor" stroke="none"/>
                <line x1="14.2" y1="17.8" x2="26" y2="6"/>
                <line x1="22.5" y1="9.5" x2="25.5" y2="12.5"/>
                <line x1="19.5" y1="12.5" x2="22.5" y2="15.5"/>
            </svg>
        </span>
        <span class="workspace__eyebrow">Boat owner &middot; New request</span>
        <h1 class="workspace__title">Request a booking</h1>
        <p class="workspace__subtitle">The marina reviews each request before it is confirmed</p>
    </header>

    <article class="plate">
        <form asp-action="Create" method="post" class="plate-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="auth-errors"></div>
            <input type="hidden" asp-for="SpotId" />

            <section class="plate-section">
                <h2 class="plate-section__title">
                    <span class="plate-section__numeral">I</span>
                    Vessel
                </h2>
                <div class="plate-section__body">
                    <div class="field">
                        <label asp-for="VesselId" class="field__label">Which vessel will berth here?</label>
                        <select asp-for="VesselId" asp-items="Model.Vessels" class="field__input">
                            <option value="">&mdash; Select a vessel &mdash;</option>
                        </select>
                        <span asp-validation-for="VesselId" class="field__error"></span>
                        <span class="field__meta">Marina will check that your vessel fits the spot.</span>
                    </div>
                </div>
            </section>

            <section class="plate-section">
                <h2 class="plate-section__title">
                    <span class="plate-section__numeral">II</span>
                    Dates
                </h2>
                <div class="plate-section__body">
                    <div class="field-row">
                        <div class="field">
                            <label asp-for="StartDate" class="field__label">Arrival</label>
                            <input asp-for="StartDate" type="date" class="field__input field__input--mono" />
                            <span asp-validation-for="StartDate" class="field__error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="EndDate" class="field__label">Departure</label>
                            <input asp-for="EndDate" type="date" class="field__input field__input--mono" />
                            <span asp-validation-for="EndDate" class="field__error"></span>
                        </div>
                    </div>
                </div>
            </section>

            @if (Model.Preview is not null)
            {
                <aside class="booking-preview" aria-label="Estimated cost">
                    <span class="booking-preview__eyebrow">Estimate</span>
                    <dl class="booking-preview__rows">
                        <div class="booking-preview__row">
                            <dt>Daily rate</dt>
                            <dd>&euro;@Model.Preview.PricePerDay.ToString("0.00")</dd>
                        </div>
                        <div class="booking-preview__row">
                            <dt>Minimum stay</dt>
                            <dd>@Model.Preview.MinBookingDays @(Model.Preview.MinBookingDays == 1 ? "night" : "nights")</dd>
                        </div>
                    </dl>
                    <div class="booking-preview__total">
                        <span class="booking-preview__total-label">Total</span>
                        <span class="booking-preview__total-value">&euro;@Model.Preview.TotalPrice.ToString("0.00")</span>
                    </div>
                </aside>
            }

            <div class="plate-form__actions">
                <a class="link--quiet" href="/browse">&larr; Back to browse</a>
                <button type="submit" class="btn btn--primary">Request booking</button>
            </div>
        </form>

        <p class="plate-aftermatter">
            <span class="plate-aftermatter__pip" aria-hidden="true"></span>
            The marina will review and confirm your request. You can cancel any time before the arrival date.
        </p>
    </article>
</section>
