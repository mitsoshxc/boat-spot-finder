@model MyBookingsViewModel
@{
    ViewData["Title"] = "My Bookings";
    var today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
}

<style>
    .rating-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; font-family: var(--font-body); color: var(--slate); letter-spacing: 0.02em; }
    .rating-chip__icon { width: 12px; height: 12px; fill: var(--brass); flex-shrink: 0; }
    .rating-chip__value { font-family: var(--font-display); font-size: 0.875rem; color: var(--ink); line-height: 1; }
    .rating-chip__divider { color: var(--slate-muted); font-size: 0.6875rem; }
    .rating-chip__count { color: var(--slate-soft); font-size: 0.6875rem; letter-spacing: 0.04em; }

    .score-static { display: inline-flex; align-items: center; gap: 4px; }
    .score-static__star { width: 16px; height: 16px; stroke: var(--brass); stroke-width: 1.4; stroke-linejoin: round; fill: none; }
    .score-static__star--on { fill: var(--brass); }

    .review-cta {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px;
        padding: 12px 14px; background: rgba(176, 141, 87, 0.06);
        border: 1px solid var(--hairline-ink); border-left: 2px solid var(--brass); border-radius: var(--r-sm);
    }
    .review-cta__label { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--brass-deep); }
    .review-cta__deadline { font-size: 0.75rem; color: var(--slate-soft); }
    .review-cta__closed { font-size: 0.8125rem; color: var(--slate-muted); font-style: italic; letter-spacing: 0.01em; }
    .review-cta--complete { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
    .review-cta--complete .review-cta__label { margin-bottom: 2px; }
    .review-cta__score { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 0.9375rem; color: var(--ink); }

    @@media (min-width: 720px) {
        .review-cta { padding: 12px 16px; }
    }

    /* Booking sections (Upcoming / Past) */
    .booking-section { margin-bottom: 40px; }
    .booking-section:last-child { margin-bottom: 0; }
    .booking-section__head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--hairline-ink); }
    .booking-section__label { font-family: var(--font-body); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--brass-deep); }
    .booking-section__count { font-size: 0.6875rem; letter-spacing: 0.06em; color: var(--slate-soft); }
    .booking-section__empty { margin: 0; padding-top: 2px; font-size: 0.875rem; color: var(--slate-soft); font-style: italic; }
    .booking-section--past .booking-section__label { color: var(--slate-soft); }
    .rule-card--past { background: var(--sand); opacity: 0.8; transition: opacity 200ms ease, transform 200ms ease, box-shadow 240ms ease, border-color 200ms ease; }
    .rule-card--past::after { border-color: rgba(60, 70, 84, 0.10); }
    .rule-card--past:hover { opacity: 1; }
    .booking-card__meta { margin: 0; font-family: var(--font-body); font-size: 0.6875rem; letter-spacing: 0.04em; color: var(--slate-soft); }
    .booking-card__meta strong { font-weight: 600; color: var(--slate); }
    .btn--dismiss { color: var(--slate-soft); background: transparent; border-color: var(--hairline-ink); }
    .btn--dismiss:hover { color: var(--ink); border-color: var(--hairline-deep); background: rgba(60, 70, 84, 0.05); }
</style>

@{
    async Task renderCard(BookingListItemViewModel b, bool isPast)
    {
        var statusKey = b.Status.ToString().ToLowerInvariant();
        var canCancel = (b.Status == BookingStatus.Pending || b.Status == BookingStatus.Confirmed)
            && b.StartDate > today;
        var vesselDeleted = string.Equals(b.VesselName, "Vessel deleted", StringComparison.Ordinal);
        var showReviewBlock = b.Status == BookingStatus.Completed;
        <li class="rule-card booking-card @(isPast ? "rule-card--past" : null)">
            <div class="booking-card__head">
                <div class="booking-card__head-text">
                    <span class="rule-card__eyebrow">@b.MarinaName</span>
                    <h2 class="rule-card__name">@b.SpotName</h2>
                </div>
                <span class="pill pill--booking pill--@statusKey">
                    <span class="pill__dot" aria-hidden="true"></span>@b.Status
                </span>
            </div>

            <div class="rule-card__range" aria-label="@($"From {b.StartDate.ToString("d MMM yyyy")} to {b.EndDate.ToString("d MMM yyyy")}")">
                <div class="rule-card__date">
                    <span class="rule-card__date-label">Arrival</span>
                    <span class="rule-card__date-value">@b.StartDate.ToString("d MMM yyyy")</span>
                </div>
                <span class="rule-card__divider" aria-hidden="true"></span>
                <div class="rule-card__date">
                    <span class="rule-card__date-label">Departure</span>
                    <span class="rule-card__date-value">@b.EndDate.ToString("d MMM yyyy")</span>
                </div>
            </div>

            <dl class="rule-card__stats">
                <div class="rule-card__stat">
                    <dt class="rule-card__stat-label">Vessel</dt>
                    <dd class="rule-card__stat-value">
                        @if (vesselDeleted)
                        {
                            <span class="rule-card__stat-value--muted">Vessel deleted</span>
                        }
                        else
                        {
                            <span>@b.VesselName</span>
                        }
                    </dd>
                </div>
                <div class="rule-card__stat">
                    <dt class="rule-card__stat-label">Total</dt>
                    <dd class="rule-card__stat-value">
                        <span>&euro;@b.TotalPrice.ToString("0.00")</span>
                    </dd>
                </div>
            </dl>

            @if (showReviewBlock)
            {
                if (b.CurrentUserScore.HasValue)
                {
                    <div class="review-cta review-cta--complete">
                        <span class="review-cta__label">You rated this stay</span>
                        <span class="review-cta__score">
                            <span class="score-static" aria-label="@($"{b.CurrentUserScore.Value} out of 5 stars")">
                                @for (var s = 1; s <= 5; s++)
                                {
                                    var on = s <= b.CurrentUserScore.Value;
                                    <svg viewBox="0 0 24 24" class="score-static__star @(on ? "score-static__star--on" : null)" aria-hidden="true">
                                        <path d="M12 3.4 L14.45 9.2 L20.6 9.7 L15.9 13.85 L17.45 19.85 L12 16.55 L6.55 19.85 L8.1 13.85 L3.4 9.7 L9.55 9.2 Z" />
                                    </svg>
                                }
                            </span>
                            <span>@b.CurrentUserScore.Value / 5</span>
                        </span>
                    </div>
                }
                else if (b.CanCurrentUserReview)
                {
                    <div class="review-cta">
                        <span class="review-cta__label">Tell us how it went</span>
                        <span class="review-cta__deadline">Window closes @b.ReviewDeadline?.ToString("d MMM yyyy")</span>
                        <a class="btn btn--primary btn--sm" href="/reviews/create?bookingId=@b.Id">Leave a review</a>
                    </div>
                }
                else if (b.ReviewDeadline.HasValue)
                {
                    <p class="review-cta__closed" style="margin: 0;">
                        Review window closed @b.ReviewDeadline.Value.ToString("d MMM yyyy").
                    </p>
                }
            }

            <p class="booking-card__meta">Booked on <strong>@b.BookingCreatedAt.ToString("d MMM yyyy")</strong></p>

            @if (!isPast && canCancel)
            {
                <div class="rule-card__actions">
                    <form method="post" action="/bookings/@b.Id/cancel" onsubmit="return confirm('Cancel this booking? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn--danger btn--sm">Cancel booking</button>
                    </form>
                </div>
            }
            else if (isPast)
            {
                <div class="rule-card__actions">
                    <form method="post" action="/bookings/@b.Id/dismiss" onsubmit="return confirm('Remove this booking from your list? It stays in our records.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn--dismiss btn--sm">Dismiss</button>
                    </form>
                </div>
            }
        </li>
    }
}

<section class="workspace">
    <header class="workspace__head">
        <span class="workspace__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                <rect x="6" y="5" width="20" height="22" rx="1"/>
                <line x1="6" y1="10" x2="26" y2="10" opacity="0.6"/>
                <line x1="10" y1="14" x2="22" y2="14" opacity="0.4"/>
                <line x1="10" y1="18" x2="20" y2="18" opacity="0.3"/>
                <line x1="10" y1="22" x2="22" y2="22" opacity="0.4"/>
                <circle cx="22" cy="22" r="1.4" fill="currentColor" stroke="none" opacity="0.7"/>
            </svg>
        </span>
        <span class="workspace__eyebrow">Boat owner &middot; Ledger</span>
        <h1 class="workspace__title">My Bookings</h1>
        <p class="workspace__lede">Your booking requests and confirmed stays. Cancel a booking any time before its arrival date.</p>
    </header>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="notice notice--warning" style="margin-bottom: 24px;">
            <p class="notice__body">@errorMsg</p>
        </div>
    }
    @if (TempData["Success"] is string successMsg)
    {
        <div class="notice notice--success" style="margin-bottom: 24px;">
            <p class="notice__body">@successMsg</p>
        </div>
    }

    @if (!Model.Pending.Any() && !Model.Confirmed.Any() && !Model.Past.Any())
    {
        <div class="empty-state">
            <span class="vignette vignette--muted" aria-hidden="true">
                <svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="0.7">
                    <rect x="10" y="8" width="44" height="32" rx="1.5"/>
                    <line x1="10" y1="16" x2="54" y2="16" opacity="0.5"/>
                    <line x1="18" y1="22" x2="46" y2="22" opacity="0.35"/>
                    <line x1="18" y1="28" x2="40" y2="28" opacity="0.3"/>
                    <line x1="18" y1="34" x2="46" y2="34" opacity="0.35"/>
                </svg>
            </span>
            <p class="empty-state__title">The ledger is empty.</p>
            <p class="empty-state__body">Find a marina and request your first spot &mdash; pending and confirmed bookings will appear here.</p>
            <div style="margin-top: 18px;">
                <a class="btn btn--ghost btn--sm" href="/browse">Browse marinas</a>
            </div>
        </div>
    }

    @if (Model.Pending.Any())
    {
        <section class="booking-section">
            <div class="booking-section__head">
                <span class="booking-section__label">Pending</span>
                <span class="booking-section__count">@Model.Pending.Count</span>
            </div>
            <ul class="rule-grid">
                @foreach (var b in Model.Pending)
                {
                    await renderCard(b, false);
                }
            </ul>
        </section>
    }

    @if (Model.Confirmed.Any())
    {
        <section class="booking-section">
            <div class="booking-section__head">
                <span class="booking-section__label">Confirmed</span>
                <span class="booking-section__count">@Model.Confirmed.Count</span>
            </div>
            <ul class="rule-grid">
                @foreach (var b in Model.Confirmed)
                {
                    await renderCard(b, false);
                }
            </ul>
        </section>
    }

    @if (Model.Past.Any())
    {
        <section class="booking-section booking-section--past">
            <div class="booking-section__head">
                <span class="booking-section__label">Past</span>
                <span class="booking-section__count">@Model.Past.Count</span>
            </div>
            <ul class="rule-grid">
                @foreach (var b in Model.Past)
                {
                    await renderCard(b, true);
                }
            </ul>
        </section>
    }
</section>
