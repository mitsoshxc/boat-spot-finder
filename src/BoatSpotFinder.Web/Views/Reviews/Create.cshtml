@model BoatSpotFinder.Web.Models.ReviewCreateViewModel
@using BoatSpotFinder.Core.Entities
@{
    ViewData["Title"] = Model.ReviewerRole == ReviewerRole.BoatOwner ? "Rate the marina" : "Rate the boat owner";
    var isBoatOwner = Model.ReviewerRole == ReviewerRole.BoatOwner;
    var eyebrow    = isBoatOwner ? "Boat owner · Review" : "Place owner · Review";
    var title      = isBoatOwner ? "Rate the marina" : "Rate the boat owner";
    var lede       = isBoatOwner
        ? $"Share how your stay at {Model.OtherPartyName} went. Your rating helps other skippers find the right marina."
        : $"Rate {Model.OtherPartyName} as a boat owner. Your rating helps other marinas decide whether to confirm their next request.";
    var backHref   = isBoatOwner ? "/bookings" : "/placeowner/spot-bookings";
}

<style>
    .review-summary { cursor: default; }
    .review-summary:hover { transform: none; box-shadow: none; border-color: var(--hairline); }
    .review-summary__note { margin: 0; font-size: 0.75rem; color: var(--slate-soft); letter-spacing: 0.01em; padding-top: 12px; border-top: 1px solid var(--hairline-ink); }

    .score-picker__wrap { display: flex; flex-direction: column; gap: 10px; }
    .score-picker { display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; gap: 8px; padding: 6px 4px; align-self: flex-start; }
    .score-picker__radio { position: absolute; opacity: 0; pointer-events: none; }
    .score-picker__star {
        position: relative; display: inline-flex; align-items: center; justify-content: center;
        width: 44px; height: 44px; color: var(--slate-muted); background: transparent;
        border: 1px solid var(--hairline-ink); border-radius: var(--r-sm); cursor: pointer;
        transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }
    .score-picker__star svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; transition: fill 160ms ease; }
    .score-picker:hover .score-picker__star:hover,
    .score-picker:hover .score-picker__star:hover ~ .score-picker__star {
        color: var(--brass-deep); border-color: var(--brass); background: rgba(176, 141, 87, 0.08); transform: translateY(-1px);
    }
    .score-picker:hover .score-picker__star:hover svg,
    .score-picker:hover .score-picker__star:hover ~ .score-picker__star svg { fill: var(--brass); }
    .score-picker__radio:checked ~ .score-picker__star,
    .score-picker__radio:checked + .score-picker__star {
        color: var(--brass-deep); border-color: var(--brass); background: rgba(176, 141, 87, 0.12);
    }
    .score-picker__radio:checked ~ .score-picker__star svg,
    .score-picker__radio:checked + .score-picker__star svg { fill: var(--brass); }
    .score-picker__radio:focus-visible + .score-picker__star { outline: none; box-shadow: 0 0 0 3px rgba(176, 141, 87, 0.32); }
    .score-picker__caption { font-size: 0.75rem; color: var(--slate-soft); letter-spacing: 0.02em; }
    .score-picker__caption strong { font-family: var(--font-display); font-size: 0.9375rem; color: var(--ink); margin-right: 6px; }

    .review-actions { display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid var(--hairline-ink); }
    .review-actions .btn { width: 100%; min-height: 44px; }

    @@media (min-width: 720px) {
        .review-actions { flex-direction: row; justify-content: flex-end; align-items: center; }
        .review-actions .btn { width: auto; }
    }

    .workspace--narrow .form { max-width: 560px; }
</style>

<section class="workspace workspace--narrow">
    <header class="workspace__head">
        <span class="workspace__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                <rect x="5" y="5" width="22" height="22" rx="1.2"/>
                <path d="M16 9.5 L17.85 14 L22.5 14.35 L18.95 17.4 L20.1 21.95 L16 19.45 L11.9 21.95 L13.05 17.4 L9.5 14.35 L14.15 14 Z"
                      fill="currentColor" stroke="none" opacity="0.85"/>
                <line x1="5" y1="10" x2="27" y2="10" opacity="0.35"/>
            </svg>
        </span>
        <span class="workspace__eyebrow">@eyebrow</span>
        <h1 class="workspace__title">@title</h1>
        <p class="workspace__lede">@lede</p>
    </header>

    <article class="rule-card review-summary" style="margin-bottom: 22px;">
        <div class="rule-card__head">
            <span class="rule-card__eyebrow">@Model.MarinaName</span>
            <h2 class="rule-card__name">@Model.SpotName</h2>
        </div>

        <div class="rule-card__range"
             aria-label="@($"From {Model.StartDate.ToString("d MMM yyyy")} to {Model.EndDate.ToString("d MMM yyyy")}")">
            <div class="rule-card__date">
                <span class="rule-card__date-label">Arrival</span>
                <span class="rule-card__date-value">@Model.StartDate.ToString("d MMM yyyy")</span>
            </div>
            <span class="rule-card__divider" aria-hidden="true"></span>
            <div class="rule-card__date">
                <span class="rule-card__date-label">Departure</span>
                <span class="rule-card__date-value">@Model.EndDate.ToString("d MMM yyyy")</span>
            </div>
        </div>

        <dl class="rule-card__stats">
            <div class="rule-card__stat">
                <dt class="rule-card__stat-label">Reviewing</dt>
                <dd class="rule-card__stat-value"><span>@Model.OtherPartyName</span></dd>
            </div>
            <div class="rule-card__stat">
                <dt class="rule-card__stat-label">Total stay</dt>
                <dd class="rule-card__stat-value"><span>&euro;@Model.TotalPrice.ToString("0.00")</span></dd>
            </div>
        </dl>

        <p class="review-summary__note">
            Review window closes @Model.ReviewDeadline.ToString("d MMM yyyy").
        </p>
    </article>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div asp-validation-summary="ModelOnly" class="notice notice--warning" style="margin-bottom: 18px;"></div>
    }

    <form method="post" class="form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BookingId" />

        <div class="field score-picker__wrap">
            <div class="field__row">
                <label class="field__label" id="score-label">Your rating</label>
                <span class="field__meta">1 = poor &middot; 5 = exceptional</span>
            </div>

            <div class="score-picker" role="radiogroup" aria-labelledby="score-label">
                @for (var i = 5; i >= 1; i--)
                {
                    var radioId = $"score-{i}";
                    var starPlural = i == 1 ? "" : "s";
                    var labelText = $"{i} star{starPlural}";
                    <input class="score-picker__radio" type="radio" asp-for="Score" value="@i" id="@radioId" />
                    <label class="score-picker__star" for="@radioId" title="@labelText" aria-label="@labelText">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.4 L14.45 9.2 L20.6 9.7 L15.9 13.85 L17.45 19.85 L12 16.55 L6.55 19.85 L8.1 13.85 L3.4 9.7 L9.55 9.2 Z" />
                        </svg>
                    </label>
                }
            </div>

            <p class="score-picker__caption" data-score-caption>Tap a star to set your rating.</p>
            <span asp-validation-for="Score" class="field__error"></span>
        </div>

        <div class="field">
            <div class="field__row">
                <label class="field__label" asp-for="Comment">Comment</label>
                <span class="field__meta">Optional</span>
            </div>
            <textarea asp-for="Comment" class="field__input" rows="4"
                      placeholder="Describe what stood out &mdash; the welcome, the dock, the quiet hours."></textarea>
            <span asp-validation-for="Comment" class="field__error"></span>
        </div>

        <div class="review-actions">
            <a class="btn btn--ghost btn--sm" href="@backHref">Back</a>
            <button type="submit" class="btn btn--primary btn--sm">Submit review</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (() => {
            const radios  = document.querySelectorAll('.score-picker__radio');
            const caption = document.querySelector('[data-score-caption]');
            if (!caption || radios.length === 0) { return; }

            const labels = {
                1: 'Disappointing — we should know what went wrong.',
                2: 'Below expectations.',
                3: 'A solid stay.',
                4: 'Great — would return.',
                5: 'Exceptional — top of the harbour.'
            };

            const update = () => {
                const checked = document.querySelector('.score-picker__radio:checked');
                if (!checked) { caption.textContent = 'Tap a star to set your rating.'; return; }
                const value = parseInt(checked.value, 10);
                caption.innerHTML = `<strong>${value}/5</strong>${labels[value] ?? ''}`;
            };

            radios.forEach((r) => r.addEventListener('change', update));
            update();
        })();
    </script>
}
