@model BrowseMarinaListViewModel
@using BoatSpotFinder.Core.Enums
@{
    ViewData["Title"] = "Browse marinas";
}

<section class="workspace workspace--narrow">
    <header class="workspace__head">
        <span class="workspace__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                <circle cx="16" cy="16" r="12" />
                <circle cx="16" cy="16" r="4" />
                <path d="M16 4 L16 8 M16 24 L16 28 M4 16 L8 16 M24 16 L28 16" />
                <path d="M16 12 L18 16 L16 20 L14 16 Z" fill="currentColor" stroke="none" opacity="0.5" />
            </svg>
        </span>
        <span class="workspace__eyebrow">Discover</span>
        <h1 class="workspace__title">Browse marinas</h1>
        <p class="workspace__lede">Find a marina and book the right spot for your vessel.</p>
    </header>

    <form class="browse-form" method="get" action="/browse" role="search">
        <div class="browse-search">
            <span class="browse-search__field">
                <svg class="browse-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
                </svg>
                <input class="browse-search__input" name="Query" type="search"
                       value="@Model.Filter.Query"
                       placeholder="Search by marina name or region"
                       aria-label="Search marinas" />
            </span>
            <button class="btn btn--primary browse-search__submit" type="submit">Search</button>
        </div>

        @if (Model.Marinas.Any())
        {
            <div class="browse-controls">
                @{
                    var from = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
                    var to = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                }
                <p class="browse-controls__count">Showing @from–@to of @Model.TotalCount @(Model.TotalCount == 1 ? "marina" : "marinas")</p>
                <label class="browse-controls__sort">
                    <span class="browse-controls__label">Sort by</span>
                    <span class="browse-controls__select-wrap">
                        <select class="browse-controls__select" name="Sort">
                            @if (Model.ShowRelevanceOption)
                            {
                                <option value="Relevance" selected="@(Model.Sort == MarinaSortOption.Relevance)">Relevance</option>
                            }
                            <option value="TopRated" selected="@(Model.Sort == MarinaSortOption.TopRated)">Top rated</option>
                            <option value="Alphabetical" selected="@(Model.Sort == MarinaSortOption.Alphabetical)">A–Z</option>
                        </select>
                        <svg class="browse-controls__chevron" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4 6 L8 10 L12 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </label>
            </div>
        }
    </form>

    @if (!Model.Marinas.Any())
    {
        <div class="empty-state">
            <span class="vignette vignette--muted" aria-hidden="true">
                <svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="0.7">
                    <circle cx="28" cy="22" r="11" />
                    <line x1="36" y1="30" x2="46" y2="40" stroke-linecap="round" />
                </svg>
            </span>
            <p class="empty-state__title">No marinas found.</p>
            <p class="empty-state__body">
                @if (!string.IsNullOrWhiteSpace(Model.Filter?.Query))
                {
                    <text>Nothing matched &ldquo;@Model.Filter.Query&rdquo;. Try a different name or </text>
                    <a class="field__hint-link" href="/browse">clear the search</a><text>.</text>
                }
                else
                {
                    <text>There are no marinas available to browse yet. Please check back soon.</text>
                }
            </p>
        </div>
    }
    else
    {
        <ul class="marina-grid">
            @foreach (var m in Model.Marinas)
            {
                var hasRating = m.AverageRating.HasValue && m.ReviewCount > 0;
                var rounded = hasRating
                    ? (int)Math.Clamp(Math.Round(m.AverageRating!.Value, MidpointRounding.AwayFromZero), 0, 5)
                    : 0;
                <li class="marina-card marina-card--link">
                    <div class="marina-card__head">
                        <span class="marina-card__region">@m.Region</span>
                    </div>
                    <h2 class="marina-card__name">@m.Name</h2>

                    @if (hasRating)
                    {
                        <span class="star-rating">
                            <span class="star-rating__stars" role="img" aria-label="Rated @m.AverageRating!.Value.ToString("0.0") out of 5">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <svg class="star-rating__star @(i <= rounded ? "star-rating__star--on" : "star-rating__star--off")" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                                    </svg>
                                }
                            </span>
                            <span class="star-rating__value">@m.AverageRating!.Value.ToString("0.0")</span>
                            <span class="star-rating__count">(@m.ReviewCount @(m.ReviewCount == 1 ? "review" : "reviews"))</span>
                        </span>
                    }
                    else
                    {
                        <span class="star-rating star-rating--empty">No reviews yet</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(m.Description))
                    {
                        <p class="marina-card__desc">@m.Description</p>
                    }

                    <p class="marina-card__meta">
                        <span class="marina-card__metric">@m.SpotCount</span>
                        <span class="marina-card__metric-label">@(m.SpotCount == 1 ? "spot" : "spots")</span>
                    </p>

                    <div class="marina-card__actions">
                        <a class="btn btn--primary btn--sm marina-card__cta" href="/browse/marina/@m.Id">View marina</a>
                    </div>
                </li>
            }
        </ul>

        @if (Model.TotalPages > 1)
        {
            Func<int, string> pageUrl = p =>
                $"/browse?Query={Uri.EscapeDataString(Model.Filter.Query ?? "")}&Sort={Model.Sort}&Page={p}";

            <nav class="pager" aria-label="Marina list pagination">
                @if (Model.HasPreviousPage)
                {
                    <a class="pager__link" href="@pageUrl(Model.Page - 1)" rel="prev">
                        <svg class="pager__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="pager__text">Previous</span>
                    </a>
                }
                else
                {
                    <span class="pager__link pager__link--disabled" aria-disabled="true">
                        <svg class="pager__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="pager__text">Previous</span>
                    </span>
                }

                <span class="pager__status">Page @Model.Page of @Model.TotalPages</span>

                @if (Model.HasNextPage)
                {
                    <a class="pager__link" href="@pageUrl(Model.Page + 1)" rel="next">
                        <span class="pager__text">Next</span>
                        <svg class="pager__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3 L11 8 L6 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                }
                else
                {
                    <span class="pager__link pager__link--disabled" aria-disabled="true">
                        <span class="pager__text">Next</span>
                        <svg class="pager__icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3 L11 8 L6 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                }
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        const sortSelect = document.querySelector('.browse-controls__select');
        if (sortSelect) {
            sortSelect.addEventListener('change', function () {
                sortSelect.form.submit();
            });
        }
    </script>
}
