@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth">
    <article class="auth-card">
        <header class="auth-card__head">
            <span class="ornament" aria-hidden="true">
                <svg viewBox="0 0 64 12" fill="none" stroke="currentColor" stroke-width="0.7">
                    <line x1="0" y1="6" x2="22" y2="6"/>
                    <circle cx="32" cy="6" r="0.8" fill="currentColor" stroke="none"/>
                    <path d="M32 1 L33.5 6 L32 11 L30.5 6 Z" fill="currentColor" stroke="none" opacity="0.6"/>
                    <path d="M26 6 L32 5 L38 6 L32 7 Z" fill="currentColor" stroke="none" opacity="0.6"/>
                    <line x1="42" y1="6" x2="64" y2="6"/>
                </svg>
            </span>
            <h1 class="auth-card__title">Welcome back.</h1>
            <p class="auth-card__lede">Sign in to manage your marina or your bookings.</p>
        </header>

        <form asp-action="Login" method="post" class="form" novalidate>
            <div asp-validation-summary="ModelOnly" class="auth-errors"></div>
            @if (TempData["LoginSuccessMessage"] is string successMessage)
            {
                <div class="notice notice--success">
                    <p class="notice__title">@successMessage</p>
                </div>
            }
            @if (ViewData.ModelState.ContainsKey("unconfirmed_email") &&
                 ViewData.ModelState["unconfirmed_email"]!.Errors.Any())
            {
                <div class="notice notice--warning">
                    <p class="notice__title">Please confirm your email before signing in.</p>
                    <p class="notice__body">
                        We sent you a verification link when you registered.
                        <a class="link" href="/account/resend-confirmation?email=@Model.Email">Resend confirmation email</a>.
                    </p>
                </div>
            }

            <div class="field">
                <label asp-for="Email" class="field__label">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" class="field__input" />
                <span asp-validation-for="Email" class="field__error"></span>
            </div>

            <div class="field">
                <div class="field__row">
                    <label asp-for="Password" class="field__label">Password</label>
                    <a asp-action="ForgotPassword" class="field__hint-link">Forgot password?</a>
                </div>
                <input asp-for="Password" type="password" autocomplete="current-password" class="field__input" />
                <span asp-validation-for="Password" class="field__error"></span>
            </div>

            <label class="check">
                <input asp-for="RememberMe" type="checkbox" class="check__input" />
                <span class="check__box" aria-hidden="true"></span>
                <span class="check__label">Keep me signed in</span>
            </label>

            <button type="submit" class="btn btn--primary btn--block">Sign in</button>
        </form>
    </article>

    <p class="auth-aside">
        New here? <a class="link" asp-action="Register">Create an account</a>
    </p>
</section>
