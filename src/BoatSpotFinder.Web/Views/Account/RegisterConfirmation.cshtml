@{
    ViewData["Title"] = "Check your email";
}

<section class="auth">
    <article class="auth-card auth-card--narrow">
        <header class="auth-card__head">
            <span class="vignette" aria-hidden="true">
                <svg viewBox="0 0 56 40" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="10" width="44" height="24" rx="1.5"/>
                    <path d="M6 12 L28 26 L50 12"/>
                    <path d="M2 38 Q8 34 14 38 T26 38 T38 38 T50 38 T58 38" opacity="0.55"/>
                </svg>
            </span>
            <h1 class="auth-card__title">Check your email.</h1>
            <p class="auth-card__lede">A confirmation email is on its way. Open the link inside to verify your address before signing in.</p>
        </header>

        <p class="auth-card__quiet">
            Didn't get it? <a class="link" href="/account/resend-confirmation">Send another</a>.
        </p>
    </article>
</section>
