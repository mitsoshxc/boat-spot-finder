@{
    ViewData["Title"] = "Password updated";
}

<section class="auth">
    <article class="auth-card auth-card--narrow">
        <header class="auth-card__head">
            <span class="vignette" aria-hidden="true">
                <svg viewBox="0 0 48 40" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="24" cy="20" r="14"/>
                    <path d="M17 20 L22 25 L31 15"/>
                </svg>
            </span>
            <h1 class="auth-card__title">Password updated.</h1>
            <p class="auth-card__lede">Your password has been reset successfully. You can now sign in with your new credentials.</p>
        </header>

        <a href="/account/login" class="btn btn--primary btn--block">Sign in</a>
    </article>
</section>
