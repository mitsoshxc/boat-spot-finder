@model IEnumerable<AdminMarinaListItemViewModel>

@if (!Model.Any())
{
    <tr class="ledger__row">
        <td class="ledger__cell" colspan="6">
            <p class="ledger__empty">No marinas match your search.</p>
        </td>
    </tr>
}
else
{
    @foreach (var m in Model)
    {
        <tr class="ledger__row @(m.IsActive ? "" : "ledger__row--inactive")">
            <td class="ledger__cell ledger__cell--primary" data-label="Name">
                <span class="ledger__value">@m.Name</span>
            </td>
            <td class="ledger__cell" data-label="Region">
                <span class="ledger__value">@m.Region</span>
            </td>
            <td class="ledger__cell" data-label="Status">
                @if (m.IsActive)
                {
                    <span class="pill pill--active"><span class="pill__dot" aria-hidden="true"></span>Active</span>
                }
                else
                {
                    <span class="pill pill--inactive"><span class="pill__dot" aria-hidden="true"></span>Inactive</span>
                }
            </td>
            <td class="ledger__cell ledger__cell--num" data-label="Admins">
                <span class="ledger__value ledger__value--mono">@m.AdminCount</span>
            </td>
            <td class="ledger__cell ledger__cell--num" data-label="Spots">
                <span class="ledger__value ledger__value--mono">@m.SpotCount</span>
            </td>
            <td class="ledger__cell ledger__cell--actions" data-label="Actions">
                <span class="ledger__actions">
                    <a class="btn btn--ghost btn--sm" href="/admin/marinas/@m.Id/edit">Edit</a>
                    <a class="btn btn--ghost btn--sm" href="/admin/marinas/@m.Id/layout">Layout</a>
                    <a class="btn btn--ghost btn--sm" href="/admin/marinas/@m.Id/spots">Spots</a>
                    <a class="btn btn--ghost btn--sm" href="/admin/marinas/@m.Id/admins">Admins</a>
                    <a class="btn btn--ghost btn--sm" href="/admin/marinas/@m.Id/invitations">Invites</a>
                    <form method="post" action="/admin/marinas/@m.Id/toggle-active" onsubmit="return confirm('@(m.IsActive ? "Deactivate this marina? It will be removed from search." : "Reactivate this marina?")');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn--ghost btn--sm">@(m.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </span>
            </td>
        </tr>
    }
}
