@model IEnumerable<MarinaAdminListItemViewModel>
@{
    ViewData["Title"] = "Marina Admins";
    var marinaName = ViewData["MarinaName"] as string;
}

<section class="workspace">
    <header class="workspace__head">
        <span class="workspace__eyebrow">Admin &middot; Access</span>
        <h1 class="workspace__title">Marina admins</h1>
        <p class="workspace__lede">
            @if (!string.IsNullOrEmpty(marinaName))
            {
                <text>Place owners with management access to <strong>@marinaName</strong>.</text>
            }
            else
            {
                <text>Place owners with management access to this marina.</text>
            }
        </p>
    </header>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="vignette vignette--muted" aria-hidden="true">
                <svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="0.7">
                    <circle cx="32" cy="19" r="8" />
                    <path d="M16 39 C16 30 24 27 32 27 C40 27 48 30 48 39" />
                </svg>
            </span>
            <p class="empty-state__title">No admins assigned to this marina yet.</p>
            <p class="empty-state__body">Invite a place owner to grant management access.</p>
        </div>
    }
    else
    {
        <div class="ledger-scroll">
            <table class="ledger">
                <thead class="ledger__head">
                    <tr class="ledger__row">
                        <th class="ledger__th" scope="col">Email</th>
                        <th class="ledger__th" scope="col">Invited At</th>
                        <th class="ledger__th" scope="col">Invited By</th>
                    </tr>
                </thead>
                <tbody class="ledger__body">
                    @foreach (var a in Model)
                    {
                        <tr class="ledger__row">
                            <td class="ledger__cell ledger__cell--primary" data-label="Email">
                                <span class="ledger__value">@a.Email</span>
                            </td>
                            <td class="ledger__cell" data-label="Invited At">
                                <span class="ledger__value ledger__value--mono">@a.InvitedAt.ToString("yyyy-MM-dd")</span>
                            </td>
                            <td class="ledger__cell" data-label="Invited By">
                                <span class="ledger__value">@a.InvitedBy</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
