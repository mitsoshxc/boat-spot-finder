@model IEnumerable<SpotListItemViewModel>
@{
    ViewData["Title"] = "Marina Spots";
    var marinaName = ViewData["MarinaName"] as string;
}

<section class="workspace">
    <header class="workspace__head">
        <span class="workspace__eyebrow">Admin &middot; Berths</span>
        <h1 class="workspace__title">Spots</h1>
        <p class="workspace__lede">
            @if (!string.IsNullOrEmpty(marinaName))
            {
                <text>All spots at <strong>@marinaName</strong>, including those deactivated.</text>
            }
            else
            {
                <text>All spots for this marina, including those deactivated.</text>
            }
        </p>
    </header>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="vignette vignette--muted" aria-hidden="true">
                <svg viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="0.7">
                    <rect x="16" y="14" width="32" height="20" rx="1.5" />
                    <path d="M16 24 H48" opacity="0.5" />
                </svg>
            </span>
            <p class="empty-state__title">This marina has no spots yet.</p>
            <p class="empty-state__body">The place owner designs spots in the layout editor.</p>
        </div>
    }
    else
    {
        <div class="ledger-scroll">
            <table class="ledger">
                <thead class="ledger__head">
                    <tr class="ledger__row">
                        <th class="ledger__th" scope="col">Name</th>
                        <th class="ledger__th" scope="col">Dimensions</th>
                        <th class="ledger__th ledger__th--num" scope="col">Price / Day</th>
                        <th class="ledger__th" scope="col">Active</th>
                    </tr>
                </thead>
                <tbody class="ledger__body">
                    @foreach (var s in Model)
                    {
                        <tr class="ledger__row @(s.IsActive ? "" : "ledger__row--inactive")">
                            <td class="ledger__cell ledger__cell--primary" data-label="Name">
                                <span class="ledger__value">@s.Name</span>
                            </td>
                            <td class="ledger__cell" data-label="Dimensions">
                                <span class="ledger__value ledger__value--mono">@s.LengthMeters.ToString("0.#") &times; @s.WidthMeters.ToString("0.#") &times; @s.DepthMeters.ToString("0.#") m</span>
                            </td>
                            <td class="ledger__cell ledger__cell--num" data-label="Price / Day">
                                @if (s.PricePerDay.HasValue)
                                {
                                    <span class="ledger__value ledger__value--mono">&euro;@s.PricePerDay.Value.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="ledger__value ledger__value--muted">Marina default</span>
                                }
                            </td>
                            <td class="ledger__cell" data-label="Active">
                                @if (s.IsActive)
                                {
                                    <span class="pill pill--active"><span class="pill__dot" aria-hidden="true"></span>Active</span>
                                }
                                else
                                {
                                    <span class="pill pill--inactive"><span class="pill__dot" aria-hidden="true"></span>Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
