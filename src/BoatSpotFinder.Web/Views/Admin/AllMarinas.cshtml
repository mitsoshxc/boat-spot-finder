@model IEnumerable<AdminMarinaListItemViewModel>
@{
    ViewData["Title"] = "All Marinas";
}

<section class="workspace">
    <header class="workspace__head">
        <a class="workspace__back" href="/admin/dashboard">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M10 3 L5 8 L10 13" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Back to dashboard
        </a>
        <span class="workspace__eyebrow">Admin &middot; Harbour</span>
        <h1 class="workspace__title">All marinas</h1>
        <p class="workspace__lede">Every marina, active and inactive. Open a marina's layout, spots, admins, or invitations.</p>
        <a class="btn btn--primary" href="/admin/marinas/create">Create marina</a>
    </header>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="notice notice--success" style="margin-bottom: 24px;">
            <p class="notice__body">@successMsg</p>
        </div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="notice notice--warning" style="margin-bottom: 24px;">
            <p class="notice__body">@errorMsg</p>
        </div>
    }

    <form class="browse-search" method="get" action="/admin/marinas" role="search"
          id="marina-search" data-search-url="/admin/marinas/search">
        <span class="browse-search__field">
            <svg class="browse-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-linecap="round" />
            </svg>
            <input class="browse-search__input" name="q" type="search"
                   value="@(ViewData["MarinaQuery"] as string)"
                   placeholder="Search by marina name or region"
                   aria-label="Search marinas" autocomplete="off" />
        </span>
        <button class="btn btn--primary browse-search__submit" type="submit">Search</button>
    </form>

    <div class="ledger-scroll">
        <table class="ledger">
            <thead class="ledger__head">
                <tr class="ledger__row">
                    <th class="ledger__th" scope="col">Name</th>
                    <th class="ledger__th" scope="col">Region</th>
                    <th class="ledger__th" scope="col">Status</th>
                    <th class="ledger__th ledger__th--num" scope="col">Admins</th>
                    <th class="ledger__th ledger__th--num" scope="col">Spots</th>
                    <th class="ledger__th ledger__th--actions" scope="col">Actions</th>
                </tr>
            </thead>
            <tbody class="ledger__body" id="marina-rows" aria-live="polite">
                @await Html.PartialAsync("_MarinaListRows", Model)
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin-marina-search.js" asp-append-version="true"></script>
}
