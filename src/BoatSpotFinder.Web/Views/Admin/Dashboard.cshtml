@{
    ViewData["Title"] = "Admin Console";
}

<section class="workspace workspace--narrow">
    <header class="workspace__head">
        <span class="workspace__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="0.9">
                <circle cx="16" cy="16" r="12" />
                <circle cx="16" cy="16" r="4" />
                <path d="M16 4 L16 8 M16 24 L16 28 M4 16 L8 16 M24 16 L28 16" />
                <path d="M16 12 L18 16 L16 20 L14 16 Z" fill="currentColor" stroke="none" opacity="0.5" />
            </svg>
        </span>
        <span class="workspace__eyebrow">Admin &middot; Console</span>
        <h1 class="workspace__title">Helm</h1>
        <p class="workspace__lede">Oversight across every marina, user, and booking. Choose a section to begin.</p>
    </header>

    <ul class="console-grid">
        <li>
            <a class="console-card" href="/admin/users">
                <span class="console-card__mark" aria-hidden="true">
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1">
                        <circle cx="14" cy="10" r="4.5" />
                        <path d="M6 23 C6 18 10 16 14 16 C18 16 22 18 22 23" />
                    </svg>
                </span>
                <h2 class="console-card__title">Users</h2>
                <p class="console-card__desc">Every registered account, role, and guest reputation.</p>
                <span class="console-card__cue">
                    Open
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8 H12 M9 5 L12 8 L9 11" /></svg>
                </span>
            </a>
        </li>
        <li>
            <a class="console-card" href="/admin/bookings">
                <span class="console-card__mark" aria-hidden="true">
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1">
                        <rect x="5" y="7" width="18" height="16" rx="1.5" />
                        <path d="M5 12 H23 M10 4 V8 M18 4 V8" />
                    </svg>
                </span>
                <h2 class="console-card__title">Bookings</h2>
                <p class="console-card__desc">Every reservation system-wide, with the power to cancel.</p>
                <span class="console-card__cue">
                    Open
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8 H12 M9 5 L12 8 L9 11" /></svg>
                </span>
            </a>
        </li>
        <li>
            <a class="console-card" href="/admin/marinas">
                <span class="console-card__mark" aria-hidden="true">
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1">
                        <path d="M14 4 V20 M9 9 L14 6 L19 9" />
                        <path d="M6 20 C8 23 20 23 22 20" />
                    </svg>
                </span>
                <h2 class="console-card__title">Marinas</h2>
                <p class="console-card__desc">Create marinas, invite owners, manage spots and access.</p>
                <span class="console-card__cue">
                    Open
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8 H12 M9 5 L12 8 L9 11" /></svg>
                </span>
            </a>
        </li>
        <li>
            <a class="console-card" href="/admin/settings">
                <span class="console-card__mark" aria-hidden="true">
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1">
                        <circle cx="14" cy="14" r="3.5" />
                        <path d="M14 4 V7 M14 21 V24 M4 14 H7 M21 14 H24 M7 7 L9 9 M19 19 L21 21 M21 7 L19 9 M9 19 L7 21" />
                    </svg>
                </span>
                <h2 class="console-card__title">Settings</h2>
                <p class="console-card__desc">Auto-decision policy and timeout for pending bookings.</p>
                <span class="console-card__cue">
                    Open
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8 H12 M9 5 L12 8 L9 11" /></svg>
                </span>
            </a>
        </li>
    </ul>
</section>
