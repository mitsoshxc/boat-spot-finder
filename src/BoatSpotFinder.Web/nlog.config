<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Info"
      internalLogFile="${basedir}/nlog-internal.log"
      internalLogToConsoleError="true">

  <!-- ${basedir} resolves to <project>/bin/Debug/net10.0/. Five "../" hops up = repo root, where /logs/ is gitignored. -->
  <variable name="logPath" value="${basedir}/../../../../../logs" />

  <targets>
    <target xsi:type="File"
            name="auditFile"
            fileName="${logPath}/audit-${shortdate}.log"
            keepFileOpen="false">
      <layout xsi:type="JsonLayout">
        <attribute name="timestamp" layout="${longdate}" />
        <attribute name="level" layout="${level}" />
        <attribute name="userId" layout="${scopeproperty:item=userId}" />
        <attribute name="userEmail" layout="${scopeproperty:item=userEmail}" />
        <attribute name="userRole" layout="${scopeproperty:item=userRole}" />
        <attribute name="action" layout="${scopeproperty:item=action}" />
        <attribute name="entityType" layout="${scopeproperty:item=entityType}" />
        <attribute name="entityId" layout="${scopeproperty:item=entityId}" />
        <attribute name="marinaId" layout="${scopeproperty:item=marinaId}" />
        <attribute name="details" layout="${scopeproperty:item=details}" />
        <attribute name="message" layout="${message}" />
      </layout>
    </target>

    <target xsi:type="File"
            name="emailFile"
            fileName="${logPath}/email-${shortdate}.log"
            keepFileOpen="false">
      <layout xsi:type="JsonLayout">
        <attribute name="timestamp" layout="${longdate}" />
        <attribute name="level" layout="${level}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
      </layout>
    </target>

  </targets>

  <rules>
    <logger name="BoatSpotFinder.Infrastructure.Email.ConsoleEmailSender" minlevel="Info" writeTo="emailFile" final="true" />
    <logger name="BoatSpotFinder.Infrastructure.Logging.NLogAuditLogger" minlevel="Info" writeTo="auditFile" />
  </rules>

</nlog>
